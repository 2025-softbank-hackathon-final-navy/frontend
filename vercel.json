{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-43-200-185-236.ap-northeast-2.compute.amazonaws.com:8080"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

